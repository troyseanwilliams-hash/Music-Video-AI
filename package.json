{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "@tootallnate/once": "2.0.1",
      "axios": "1.18.0",
      "body-parser": "2.3.0",
      "brace-expansion": "2.1.4",
      "browserslist": "4.28.7",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.6",
      "fast-xml-builder": "1.1.7",
      "js-yaml": "4.3.1",
      "linkify-it": "5.0.2",
      "lodash": "4.18.0",
      "markdown-it": "14.2.0",
      "nanoid@3": "3.3.18",
      "nanoid@5": "5.1.16",
      "path-to-regexp": "8.4.0",
      "postcss": "8.5.23",
      "qs": "6.16.0",
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "uuid@8": "11.1.1",
      "uuid@9": "11.1.1",
      "ws": "8.21.0",
      "yaml": "2.8.3"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "stripe": "^22.1.0",
    "stripe-replit-sync": "^1.0.0"
  }
}
